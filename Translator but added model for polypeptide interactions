codon_table = {
    # Alanine (A)
    'GCA':'A', 'GCC':'A', 'GCG':'A', 'GCU':'A',
    # Arginine (R)
    'AGA':'R', 'AGG':'R', 'CGA':'R', 'CGC':'R', 'CGG':'R', 'CGU':'R',
    # Asparagine (N)
    'AAC':'N', 'AAU':'N',
    # Aspartic acid (D)
    'GAC':'D', 'GAU':'D',
    # Cysteine (C)
    'UGC':'C', 'UGU':'C',
    # Glutamic acid (E)
    'GAA':'E', 'GAG':'E',
    # Glutamine (Q)
    'CAA':'Q', 'CAG':'Q',
    # Glycine (G)
    'GGA':'G', 'GGC':'G', 'GGG':'G', 'GGU':'G',
    # Histidine (H)
    'CAC':'H', 'CAU':'H',
    # Isoleucine (I)
    'AUA':'I', 'AUC':'I', 'AUU':'I',
    # Leucine (L)
    'CUA':'L', 'CUC':'L', 'CUG':'L', 'CUU':'L', 'UUA':'L', 'UUG':'L',
    # Lysine (K)
    'AAA':'K', 'AAG':'K',
    # Methionine (M)
    'AUG':'M',
    # Phenylalanine (F)
    'UUC':'F', 'UUU':'F',
    # Proline (P)
    'CCA':'P', 'CCC':'P', 'CCG':'P', 'CCU':'P',
    # Serine (S)
    'AGC':'S', 'AGU':'S', 'UCA':'S', 'UCC':'S', 'UCG':'S', 'UCU':'S',
    # Threonine (T)
    'ACA':'T', 'ACC':'T', 'ACG':'T', 'ACU':'T',
    # Tryptophan (W)
    'UGG':'W',
    # Tyrosine (Y)
    'UAC':'Y', 'UAU':'Y',
    # Valine (V)
    'GUA':'V', 'GUC':'V', 'GUG':'V', 'GUU':'V',
    # STOP Codons (-STOP-CODON-HIT-)
    'UAA':'-STOP-CODON-HIT-', 'UAG':'-STOP-CODON-HIT-', 'UGA':'-STOP-CODON-HIT-'
}

biochem_names = {
    'A': 'Ala', 'R': 'Arg', 'N': 'Asn', 'D': 'Asp', 'C': 'Cys',
    'E': 'Glu', 'Q': 'Gln', 'G': 'Gly', 'H': 'His', 'I': 'Ile',
    'L': 'Leu', 'K': 'Lys', 'M': 'Met', 'F': 'Phe', 'P': 'Pro',
    'S': 'Ser', 'T': 'Thr', 'W': 'Trp', 'Y': 'Tyr', 'V': 'Val', '?': '???'
}

Full_names = {
    'A': 'Alanine', 'R': 'Arginine', 'N': 'Asparagine', 'D': 'Aspartic-acid', 'C': 'Cysteine',
    'E': 'Glutamic Acid', 'Q': 'Glutamine', 'G': 'Glycine', 'H': 'Histidine', 'I': 'Isoleucine',
    'L': 'Leucine', 'K': 'Lysine', 'M': 'Methionine', 'F': 'Phenylalanine', 'P': 'Proline',
    'S': 'Serine', 'T': 'Threonine', 'W': 'Tryptophan', 'Y': 'Tyrosine', 'V': 'Valine', '?': 'Unknown'
}


dna_sequence = input("Enter a DNA sequence: ").strip().upper()
print(f"Input DNA sequence: {dna_sequence}")

print("choose amino acid output format")
print("1. Single-letter code")
print("2. Three-letter code")
print("3. Full_name")

output_format = input("Enter your choice (1/2/3): ").strip()

mrna_sequence = dna_sequence.replace("T", "U")

print(f"\n DNA:  {dna_sequence}")
print(f"\n mRNA: {mrna_sequence}")

protein = []

for i in range(0, len(mrna_sequence), 3):
    codon = mrna_sequence[i:i+3]

    if len(codon) < 3:
        break 

    amino_acid = codon_table.get(codon, '?')

    protein.append(amino_acid)

    if amino_acid == '-STOP-CODON-HIT-':
        print("\n ***STOP CODON (UAA, UAG, UGA) TRANSLATION ENDS*** \n")
        break


protein_string = "".join(protein)
print("\n Resulting Output (USE CODON TABLE TO INFER LETTERS OR SELECT 3 FOR OUTPUT):", protein_string)


if output_format not in ['1', '2', '3']:
    print("\n no format selected from 1, 2, or 3")

if output_format == '1':
    print("\n Amino Acid Sequence (Single-letter):", protein_string) if protein_string else print("No DNA sequence provided.")


elif output_format == '2':
    print("\n Amino Acid Sequence (Three-letter):", "".join(biochem_names.get(aa, 'Unknown') for aa in protein)) if protein_string else print("No DNA sequence provided.")


elif output_format == '3':
    print("\n Amino Acid Sequence (Full Name):", "".join(Full_names.get(aa, 'Unknown') for aa in protein)) if protein_string else print("No DNA sequence provided.")

acidic = {"D", "E"}
basic = {"K", "R"}
polar = {"N", "Q", "S", "T", "Y", "C", "H"}
apolar = {"A", "V", "I", "L", "M", "F", "W", "P", "G"}

property_colours= { "Acidic": "#ef5350",
  "Basic": "#42a5f5",
  "Polar": "#66bb6a",
  "Apolar": "#b0bec5" }

def get_property(aa):
  if aa in acidic:
     return "Acidic"
  elif aa in basic:
     return "Basic"
  elif aa in polar:
     return "Polar"
  elif aa in apolar:
     return "Apolar"


def create_3d_polypeptide(protein):
    sequence = [
        aa for aa in protein
        if aa in biochem_names and aa != "?"
    ]

    if not sequence:
        print("NO AMINO ACIDS AVAILABLE FOR VISUALIZATION")
        return

    rng = np.random.default_rng(42)
    positions = [np.zeros(3)]

    for _ in range(1, len(sequence)):
        direction = rng.normal(size=3)
        direction /= np.linalg.norm(direction)
        positions.append(positions[-1] + direction)

    coords = np.array(positions)
    coords -= coords.mean(axis=0)

    properties = [get_property(aa) for aa in sequence]

    fig = go.Figure()
    fig.add_trace(go.Scatter3d(
        x=coords[:, 0],

        y=coords[:, 1],

        z=coords[:, 2],
        mode="lines",
        line=dict(color="white", width=5),
        name="Polypeptide backbone"
    ))

    for category, color in property_colours.items():
        indices = [
            i for i, prop in enumerate(properties)
            if prop == category
        ]

        if not indices:
            continue

        fig.add_trace(go.Scatter3d(
            x=coords[indices, 0],
            y=coords[indices, 1],
            z=coords[indices, 2],
            mode="markers+text",
            text=[
                f"{sequence[i]}{i + 1}"
                for i in indices
            ],
            textposition="top center",
            marker=dict(size=7, color=color),
            name=category,
            customdata=[
                [
                    Full_names.get(sequence[i], "Unknown"),
                    biochem_names.get(sequence[i], "?"),
                    category
                ]
                for i in indices
            ],
            hovertemplate=(
                "Amino acid: %{customdata[0]}<br>"
                "Code: %{customdata[1]}<br>"
                "Property: %{customdata[2]}<br>"
                "Position: %{text}"
            )
        ))

    interaction_styles = {
        "Acidic-Basic": ("#ce93d8", 1.8),
        "Polar-Polar": ("#ffee58", 1.5),
        "Apolar-Apolar": ("#ffb74d", 1.5)
    }

    shown_interactions = set()
    interaction_counts = {
        name: 0 for name in interaction_styles
    }

    for i in range(len(sequence)):
        for j in range(i + 4, len(sequence)):
            distance = np.linalg.norm(coords[i] - coords[j])

            p1 = properties[i]
            p2 = properties[j]

            if {p1, p2} == {"Acidic", "Basic"}:
                kind = "Acidic-Basic"
            elif p1 == p2 == "Polar":
                kind = "Polar-Polar"
            elif p1 == p2 == "Apolar":
                kind = "Apolar-Apolar"
            else:
                continue

            color, threshold = interaction_styles[kind]

            if distance < threshold:
                interaction_counts[kind] += 1

                fig.add_trace(go.Scatter3d(
                    x=[coords[i, 0] , coords[j, 0]],
                    y=[coords[i, 1] , coords[j, 1]],
                    z=[coords[i, 2] , coords[j, 2]],
                    mode="lines",
                    line=dict(
                        color=color,
                        width=4,
                        dash="dash"
                    ),
                    name=kind.replace("-", " ") + " contact",
                    legendgroup=kind,
                    showlegend=kind not in shown_interactions,
                    hovertemplate=(
                        f"{kind} candidate<br>"
                        f"Residues {i + 1} and {j + 1}<br>"
                        f"Model distance: {distance:.2f} units"
                        "<extra></extra>"
                    )
                ))

                shown_interactions.add(kind)

    fig.update_layout(
        title=(
            "3D Polypeptide Model"
            "<br><sup> Illustrative model for fun, not a real protein fold (VERY UNREALISTIC)</sup>"
        ),
        scene=dict(
            xaxis_title="X",
            yaxis_title="Y",
            zaxis_title="Z",
            aspectmode="data"
        ),
        template="plotly_dark",
        legend=dict(title="Amino acid properties"),
        margin=dict(l=0, r=0, t=80, b=0)
    )
    fig.write_html("polypeptide_3d.html", auto_open=True)

    print("\n3D model saved as polypeptide_3d.html")
    print("Residues visualized:", len(sequence))
    print("\n Amount of contact counts:")
    print("\n completed model outputed into browser \n")

    for name, count in interaction_counts.items():
        print(f"{name}: {count}")

    fig.show()

create_3d_polypeptide(protein)
